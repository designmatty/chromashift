{
  "name": "@chromashift/desktop",
  "version": "0.1.0-preview.11",
  "description": "ChromaShift",
  "productName": "ChromaShift",
  "author": "ChromaShift",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "install-electron --no && node scripts/run-development.mjs",
    "build": "electron-vite build",
    "check:renderer-budget": "node scripts/check-renderer-budget.mjs",
    "package:dir": "electron-builder --win dir --x64 --publish never && node scripts/package-footprint.mjs --check",
    "package:win": "electron-builder --win nsis --x64 --publish never && node scripts/package-footprint.mjs --check --installer",
    "package:release:prepare": "electron-builder --win dir --x64 --publish never && node scripts/package-footprint.mjs --check",
    "package:release:installer": "electron-builder --config electron-builder.release.yml --win nsis --x64 --prepackaged release/win-unpacked --publish never",
    "package:release:finalize": "node ../../scripts/finalize-release-metadata.mjs && node scripts/package-footprint.mjs --check --installer",
    "check:package-budget": "node scripts/package-footprint.mjs --check --installer",
    "measure:memory": "node scripts/measure-memory.mjs",
    "measure:performance": "node scripts/measure-memory.mjs --packaged --check",
    "smoke:package": "node scripts/package-smoke.mjs",
    "test": "install-electron --no && vitest run src/main src/shared src/renderer",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "dependencies": {
    "@chakra-ui/react": "3.36.1",
    "@chromashift/core": "*",
    "@chromashift/native-client": "*",
    "@dnd-kit/dom": "0.5.0",
    "@dnd-kit/helpers": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "@emotion/react": "11.14.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource-variable/inter": "5.3.0",
    "electron-updater": "6.8.10",
    "lucide-react": "1.31.0",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.7.7",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
