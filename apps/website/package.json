{
  "name": "@chromashift/website",
  "version": "0.0.0",
  "description": "The chromashift.io product website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "render:assets": "install-electron --no && electron scripts/render-assets.mjs",
    "test": "vitest run",
    "smoke": "npm run build && install-electron --no && electron scripts/smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.2.8",
    "@fontsource-variable/geist-mono": "5.2.8"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "wrangler": "4.145.0"
  }
}
